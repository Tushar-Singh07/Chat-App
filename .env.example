# Frontend Environment Variables (Vercel)
# ======================================

# The public URL of your deployed Render backend (including /api)
# Example: https://your-backend-service.onrender.com/api
# For local development with Vite dev proxy: leave blank or set to http://localhost:5000/api
VITE_API_URL=https://your-backend-service.onrender.com/api

# The Socket.IO real-time server URL (Render backend base URL without /api)
# Example: https://your-backend-service.onrender.com
# Note: If omitted, the app will automatically derive this from VITE_API_URL
VITE_SOCKET_URL=https://your-backend-service.onrender.com

# Optional WebRTC TURN Server configuration (for strict firewalls/NAT)
# If left blank, Google public STUN servers are used by default
# VITE_TURN_SERVER_URL=turn:your-turn-server.com:3478
# VITE_TURN_USERNAME=your_username
# VITE_TURN_CREDENTIAL=your_credential
