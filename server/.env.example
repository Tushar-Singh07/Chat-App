# Backend Environment Variables (Render Web Service)
# ====================================================

# Port automatically assigned by Render (default 5000)
PORT=5000

# Environment mode: set to 'production' on Render
NODE_ENV=production

# MongoDB Atlas Connection String
# Replace <username> and <password> with your Atlas Database user credentials
# Make sure to allow IP access (0.0.0.0/0) in MongoDB Atlas Network Access
MONGO_URI=mongodb+srv://<username>:<password>@mycluster.xltdkcb.mongodb.net/chatapp?retryWrites=true&w=majority

# Secret key used for signing JSON Web Tokens (use a long, random string)
JWT_SECRET=generate_a_secure_random_jwt_secret_key_minimum_32_characters

# JWT Expiration time (e.g., 7d, 30d)
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins for CORS & Socket.IO
# In production on Render: Set this to your live Vercel URL
# You can provide multiple comma-separated URLs (e.g., https://your-app.vercel.app,http://localhost:5173)
CLIENT_URL=https://your-frontend-app.vercel.app

# ====================================================
# Email Verification Configuration (Optional)
# If provided, 6-digit codes will be emailed to users
# ====================================================

# 1. Gmail SMTP (Recommended):
# Use your Google Account's 16-character App Password (NOT your regular Gmail password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password
EMAIL_FROM="WhatsApp Web" <your_email@gmail.com>

# 2. Or Custom SMTP:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_SECURE=false
